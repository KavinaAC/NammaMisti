<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Estimation"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimate total project cost and materials."
            android:textSize="18sp"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/etArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Area (sq.ft)"
            android:inputType="numberDecimal"
            android:layout_marginTop="25dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <EditText
            android:id="@+id/etRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cost Per Sq.ft"
            android:inputType="numberDecimal"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Estimate"
            android:backgroundTint="#0D47A1"
            android:textColor="@android:color/white"
            android:layout_marginTop="25dp"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estimated Cost: ₹0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back To Home"
            android:backgroundTint="#616161"
            android:textColor="@android:color/white"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</ScrollView>